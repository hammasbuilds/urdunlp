# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Env & secrets
.env
.env.local
*.key

# Data & models - never commit these
data/raw/*
data/processed/*
!data/**/.gitkeep
# Everything the measurement scripts fetch or write: Dakshina, the Wikipedia
# samples, the English sentences, vocabulary counts and reports. ~35 MB, CC BY-SA,
# and reproducible with the fetch scripts. Anchored to the root so that the
# package's own src/urdunlp/data/ - the bundled models - is NOT ignored.
# The CONTENTS, not the directory: git does not descend into an ignored directory, so a
# negation inside one can never take effect.
/data/*
# ...except the two small files that make an ignored corpus checkable - the identity of
# every corpus file the published numbers were measured over, and the article ids each
# Wikipedia sample was drawn from. They answer the two questions nobody could answer
# before: whether a corpus on disk is the one the numbers describe, and how to fetch it
# again.
!/data/FINGERPRINT.tsv
!/data/wiki/
/data/wiki/*
!/data/wiki/*.pages.tsv

models/
.cache/

# Eval output
eval_runs/
*.db

# Node
node_modules/
.next/

# OS
.DS_Store
Thumbs.db

# Local-only front end for personal checking and for showing the project on this
# machine. Deliberately NOT part of the package or the repo: demo.py is the published
# demonstration, this is the clickable self-check that lives on one desktop.
_local/
demo_report.html
demo_results.json
demo/
